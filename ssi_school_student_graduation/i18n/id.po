#. module: ssi_school_student_graduation
#: code:addons/ssi_school_student_graduation/models/school_student_graduation.py:0
#, python-format
msgid ""
"\n"
"Context: Change student graduation state into %s\n"
"Database ID: %s\n"
"Problem: Another graduation for student '%s' is already draft or\n"
"waiting for approval\n"
"Solution: Complete, reject, or cancel the other graduation before\n"
"confirming this one\n"
msgstr ""
"\n"
"Konteks: Mengubah status kelulusan siswa menjadi %s\n"
"ID Basis Data: %s\n"
"Masalah: Kelulusan lain untuk siswa '%s' masih berstatus draf atau\n"
"menunggu persetujuan\n"
"Solusi: Selesaikan, tolak, atau batalkan kelulusan lainnya sebelum\n"
"mengonfirmasi kelulusan ini\n"

#. module: ssi_school_student_graduation
#: code:addons/ssi_school_student_graduation/models/school_student_graduation.py:0
#, python-format
msgid ""
"\n"
"Context: Change student graduation state into %s\n"
"Database ID: %s\n"
"Problem: Student '%s' is not in enrolled state\n"
"Solution: The student must be enrolled before this graduation can be\n"
"confirmed or completed\n"
msgstr ""
"\n"
"Konteks: Mengubah status kelulusan siswa menjadi %s\n"
"ID Basis Data: %s\n"
"Masalah: Siswa '%s' tidak berstatus terdaftar\n"
"Solusi: Siswa harus terdaftar sebelum kelulusan ini dapat\n"
"dikonfirmasi atau diselesaikan\n"

#. module: ssi_school_student_graduation
#: code:addons/ssi_school_student_graduation/models/school_student_graduation.py:0
#, python-format
msgid ""
"\n"
"Context: Complete student graduation\n"
"Database ID: %s\n"
"Problem: Student '%s' is no longer enrolled\n"
"Solution: Cancel this graduation; the student must stay enrolled until\n"
"the graduation is completed\n"
msgstr ""
"\n"
"Konteks: Menyelesaikan kelulusan siswa\n"
"ID Basis Data: %s\n"
"Masalah: Siswa '%s' tidak lagi terdaftar\n"
"Solusi: Batalkan kelulusan ini; siswa harus tetap terdaftar sampai\n"
"kelulusan diselesaikan\n"

#. module: ssi_school_student_graduation
#: code:addons/ssi_school_student_graduation/models/school_student_graduation_batch.py:0
#, python-format
msgid ""
"\n"
"Context: Complete student graduation batch\n"
"Database ID: %s\n"
"Problem: No student line has been added to this batch\n"
"Solution: Populate or add at least one student line before completing\n"
"this batch\n"
msgstr ""
"\n"
"Konteks: Menyelesaikan batch kelulusan siswa\n"
"ID Basis Data: %s\n"
"Masalah: Belum ada baris siswa yang ditambahkan ke batch ini\n"
"Solusi: Isi atau tambahkan setidaknya satu baris siswa sebelum\n"
"menyelesaikan batch ini\n"

#. module: ssi_school_student_graduation
#: code:addons/ssi_school_student_graduation/models/school_student_graduation_batch.py:0
#, python-format
msgid ""
"\n"
"Context: Complete student graduation batch\n"
"Database ID: %s\n"
"Problem: Status check ineligible student(s) failed: %s\n"
"Solution: Remove the ineligible student line(s), or ensure every\n"
"selected student is still in the enrolled state, before completing\n"
"this batch\n"
msgstr ""
"\n"
"Konteks: Menyelesaikan batch kelulusan siswa\n"
"ID Basis Data: %s\n"
"Masalah: Pemeriksaan status gagal untuk siswa yang tidak memenuhi syarat: %s\n"
"Solusi: Hapus baris siswa yang tidak memenuhi syarat, atau pastikan setiap\n"
"siswa yang dipilih masih berstatus terdaftar, sebelum menyelesaikan\n"
"batch ini\n"

